generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teneur {
  id        Int       @id @default(autoincrement())
  valeur    Float     @unique
  agentId   Int
  agents    Agent     @relation(fields: [agentId], references: [id])
  produits  Produit[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Devise {
  id           Int            @id @default(autoincrement())
  nom          String         @unique
  code         String         @unique @db.VarChar(5)
  symbole      String         @db.VarChar(5)
  tauxDEchange Int
  agentId      Int
  agent        Agent          @relation(fields: [agentId], references: [id])
  produits     Produit[]
  paiements    Paiement[]
  caisses      Caisse[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  DetailPanier DetailPanier[]
}

enum Role {
  ADMIN
  AGENT
}

model Entreprise {
  id                       Int        @id @default(autoincrement())
  raison_sociale           String?
  forme_juridique          String?
  rccm                     String?
  num_impot                String?
  identification_nationale String?
  email                    String     @unique
  secteur_d_activite       String?
  contenu                  String?
  slogan                   String?
  vision                   String?    @db.Text
  date_de_creation         DateTime?
  logo                     String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  Adresse                  Adresse[]
  Contact                  Contact[]
  Vente                    Vente[]
  Achat                    Achat[]
  Commande                 Commande[]
  Depense                  Depense[]
}

enum Sexe {
  HOMME
  FEMME
}

enum Poste {
  DIRECTEUR
  SECRETAIRE
  CAISSIER
  GERANT
}

model Agent {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  nom         String
  postnom     String?
  nom_complet String?
  sexe        Sexe?
  role        Role          @default(AGENT)
  poste       Poste?
  picture     String?
  adresses    Adresse[]
  contacts    Contact[]
  produits    Produit[]
  ventes      Vente[]
  achats      Achat[]
  teneurs     Teneur[]
  devises     Devise[]
  paniers     Panier[]
  caisses     Caisse[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Fournisseur Fournisseur[]
  Commande    Commande[]
  Depense     Depense[]
}

model Client {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  nom         String
  postnom     String?
  nom_complet String?
  sexe        Sexe?
  picture     String?
  adresses    Adresse[]
  contacts    Contact[]
  ventes      Vente[]
  paniers     Panier[]
  commandes   Commande[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Adresse {
  id            Int          @id @default(autoincrement())
  ville         String?
  adresse       String
  isActive      Boolean      @default(true)
  agentId       Int?
  fournisseurId Int?
  clientId      Int?
  entrepriseId  Int?
  agent         Agent?       @relation(fields: [agentId], references: [id])
  entreprise    Entreprise?  @relation(fields: [entrepriseId], references: [id])
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])
  client        Client?      @relation(fields: [clientId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Contact {
  id            Int          @id @default(autoincrement())
  tel           String       @unique
  isActive      Boolean      @default(true)
  agentId       Int?
  fournisseurId Int?
  clientId      Int?
  entrepriseId  Int?
  entreprise    Entreprise?  @relation(fields: [entrepriseId], references: [id])
  client        Client?      @relation(fields: [clientId], references: [id])
  agent         Agent?       @relation(fields: [agentId], references: [id])
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum TypeProduit {
  CIMENT
  CARREAU
  FER_A_BETON
  JEPSEN
  AUTRES
}

model Fournisseur {
  id           Int            @id @default(autoincrement())
  nom          String         @unique
  email        String         @unique
  typeProduit  TypeProduit?
  autresType   String?
  agentId      Int
  agent        Agent          @relation(fields: [agentId], references: [id])
  ventes       Vente[]
  adresses     Adresse[]
  contacts     Contact[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  DetailPanier DetailPanier[]
}

model Produit {
  id             Int            @id @default(autoincrement())
  designation    String
  typeProduit    TypeProduit?
  autresType     String?
  prixUnitaire   Float
  qtteDisponible Int            @default(0)
  description    String?
  deviseId       Int
  teneurId       Int?
  agentId        Int
  detailsPaniers DetailPanier[]
  agent          Agent          @relation(fields: [agentId], references: [id])
  devise         Devise         @relation(fields: [deviseId], references: [id])
  teneur         Teneur?        @relation(fields: [teneurId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum TypeModePaiement {
  CASH
  BANQUE
  CREDIT
  MOITIER_CREDIT
  MOITIER_CASH
}

model ModePaiement {
  id           Int               @id @default(autoincrement())
  type         TypeModePaiement? @default(CASH)
  soldeActuel  Float?            @default(0)
  caisseId     Int
  caisse       Caisse            @relation(fields: [caisseId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  Paiement     Paiement[]
  DetailPanier DetailPanier[]
}

model Paiement {
  id             Int          @id @default(autoincrement())
  montant        Float?
  modePaiementId Int
  deviseId       Int
  caisseId       Int
  venteId        Int?
  achatId        Int?
  commandeId     Int?
  depenseId      Int?
  modePaiement   ModePaiement @relation(fields: [modePaiementId], references: [id])
  vente          Vente?       @relation(fields: [venteId], references: [id])
  achat          Achat?       @relation(fields: [achatId], references: [id])
  commande       Commande?    @relation(fields: [commandeId], references: [id])
  depense        Depense?     @relation(fields: [depenseId], references: [id])
  caisse         Caisse       @relation(fields: [caisseId], references: [id])
  devise         Devise       @relation(fields: [deviseId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Caisse {
  id           Int            @id @default(autoincrement())
  nom          String         @unique @db.VarChar(100)
  deviseId     Int
  agentId      Int
  statut       StatutCaisse   @default(OUVERTE)
  description  String?        @db.Text
  devise       Devise         @relation(fields: [deviseId], references: [id])
  agent        Agent          @relation(fields: [agentId], references: [id])
  paiements    Paiement[]
  Depense      Depense[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ModePaiement ModePaiement[]
}

enum StatutVente {
  // EN_ATTENTE
  CONFIRME
  REMBOURSE
  ANNULE
}

model Vente {
  id               Int          @id @default(autoincrement())
  statut           StatutVente  @default(CONFIRME)
  nom              String?
  tel              String?
  dateLivraison    DateTime?    @default(now())
  adresseLivraison String?      @db.VarChar(255)
  notes            String?      @db.Text
  clientId         Int?
  agentId          Int?
  fournisseurId    Int?
  entrepriseId     Int          @default(1)
  panierId         Int
  enregistrerPar   String?
  panier           Panier       @relation(fields: [panierId], references: [id])
  agent            Agent?       @relation(fields: [agentId], references: [id])
  fournisseur      Fournisseur? @relation(fields: [fournisseurId], references: [id])
  entreprise       Entreprise?  @relation(fields: [entrepriseId], references: [id])
  client           Client?      @relation(fields: [clientId], references: [id])
  paiements        Paiement[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

enum statutPanier {
  EN_COURS
  VALIDE
  ANNULE
}

model Panier {
  id            Int            @id @default(autoincrement())
  agentId       Int?
  clientId      Int?
  statut        statutPanier   @default(EN_COURS)
  agent         Agent?         @relation(fields: [agentId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  detailPaniers DetailPanier[]
  achats        Achat[]
  ventes        Vente[]
  commandes     Commande[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DetailPanier {
  id             Int           @id @default(autoincrement())
  produitId      Int
  qtte           Int
  prixUnitaire   Float
  prixTotalHT    Float
  prixTotalTTC   Float
  panierId       Int
  deviseId       Int?
  modePaiementId Int?
  fournisseurId  Int?
  fournisseur    Fournisseur?  @relation(fields: [fournisseurId], references: [id])
  modePaiement   ModePaiement? @relation(fields: [modePaiementId], references: [id])
  devise         Devise?       @relation(fields: [deviseId], references: [id])
  produit        Produit       @relation(fields: [produitId], references: [id])
  panier         Panier        @relation(fields: [panierId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum StatutAchat {
  EN_COURS
  TERMINE
  ANNULE
}

model Achat {
  id           Int         @id @default(autoincrement())
  statut       StatutAchat @default(EN_COURS)
  panierId     Int
  // fournisseurId Int?
  agentId      Int
  entrepriseId Int         @default(1)
  entreprise   Entreprise  @relation(fields: [entrepriseId], references: [id])
  panier       Panier      @relation(fields: [panierId], references: [id])
  // fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])
  agent        Agent       @relation(fields: [agentId], references: [id])
  paiements    Paiement[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum StatutCommande {
  EN_ATTENTE_PAIEMENT
  PAIEE
  LIVREE
  ANNULEE
}

model AcheteurTiers {
  id       Int        @id @default(autoincrement())
  nom      String
  postnom  String
  tel      String
  Commande Commande[]
}

model Commande {
  id               Int            @id @default(autoincrement())
  panierId         Int
  statut           StatutCommande @default(EN_ATTENTE_PAIEMENT)
  dateLivraison    DateTime?      @default(now())
  adresseLivraison String?        @db.VarChar(255)
  notes            String?        @db.Text
  clientId         Int?
  agentId          Int?
  estReserve       Boolean?
  entrepriseId     Int            @default(1)
  Paiement         Paiement[]
  acheteurTiersId  Int?
  panier           Panier         @relation(fields: [panierId], references: [id])
  entreprise       Entreprise     @relation(fields: [entrepriseId], references: [id])
  acheteurTiers    AcheteurTiers? @relation(fields: [acheteurTiersId], references: [id])
  agent            Agent?         @relation(fields: [agentId], references: [id])
  client           Client?        @relation(fields: [clientId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum StatutCaisse {
  OUVERTE
  FERMEE
}

// Add modePaiement as a table
enum MotifsDepense {
  ACHAT_FOURNITURES
  PAIEMENT_SALAIRE
  PAIEMENT_LOYER
  PAIEMENT_EMPRUNT
  PAIEMENT_TAXE
  AUTRES
}

// Or change to charge table...
model Depense {
  id               Int           @id @default(autoincrement())
  caisseId         Int
  referenceExterne String?       @db.VarChar(100)
  motif            MotifsDepense
  description      String?       @db.Text
  agentId          Int
  entrepriseId     Int           @default(1)
  Paiement         Paiement[]
  entreprise       Entreprise    @relation(fields: [entrepriseId], references: [id])
  caisse           Caisse        @relation(fields: [caisseId], references: [id])
  agent            Agent         @relation(fields: [agentId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}
